{
  "name": "aira-browser",
  "version": "0.3.0",
  "description": "Aira — a calm glass-style desktop browser prototype",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/renderer.js && node --check src/renderer/newtab.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "marphley",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aira.browser",
    "productName": "Aira",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Network",
      "target": "AppImage"
    }
  }
}
